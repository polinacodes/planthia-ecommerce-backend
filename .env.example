# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Strapi secrets
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (postgres in production; sqlite needs the better-sqlite3 package)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=planthia
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# URLs
FRONTEND_URL=http://localhost:3000
STRAPI_URL=http://localhost:1337

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# PayPal (PAYPAL_ENV: sandbox o live)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Resend
RESEND_API_KEY=

# Redis / Valkey (only used when NODE_ENV=production)
REDIS_URL=

# Cloudinary (subida de imágenes desde el admin)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
