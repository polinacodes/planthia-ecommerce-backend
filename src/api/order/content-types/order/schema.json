{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "total": {
      "type": "decimal"
    },
    "order_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "delivered",
        "failure"
      ]
    },
    "customer_email": {
      "type": "email"
    },
    "items": {
      "type": "json"
    },
    "payment_id": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "orders"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "phone": {
      "type": "integer"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "subtotal": {
      "type": "decimal"
    },
    "shipping_cost": {
      "type": "decimal"
    },
    "payment_method": {
      "type": "string"
    },
    "discount_code": {
      "type": "string"
    },
    "discount_amount": {
      "type": "decimal"
    }
  }
}
